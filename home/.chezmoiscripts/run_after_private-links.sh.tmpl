{{- /* machineProfile が未設定の古い chezmoi.toml でもエラーにならないよう index で参照する */ -}}
{{- $machineProfile := index . "machineProfile" | default "" -}}
#!/bin/bash
# private リポジトリ (~/.config/private) の素材を HOME 配下へ配置する。
# run_onchange_ ではなく run_after_ にして、chezmoi apply のたびに実行する。
# 配置先の状態 (rm で消したリンクなど) は chezmoi のハッシュ管理から見えないため、
# 毎回「あるべき状態か」を調べ、足りないものだけ作る (冪等)。通信はしない。
#
# 方針:
# - private 側にファイルが無ければ何もしない
# - リンク先に実ファイルがある場合は上書きしない。あるべき状態と違うときだけ警告する (手動で退避してから apply する)
# - private 側のファイルを編集すると、リンク先からそのまま見える (コピーしない)
# - 秘密情報 (トークン・秘密鍵・AWS の access key) は private 側にも置かない
# - AWS: machineProfile = work で aws/config.work があるマシンは、aws/config と結合した実ファイルを作る (merge_aws_config)
set -euo pipefail

PRIVATE_DIR="$HOME/.config/private"
[ -d "$PRIVATE_DIR" ] || exit 0
MACHINE_PROFILE={{ $machineProfile | quote }}

# 作成するディレクトリを自分だけが読めるようにする
umask 077

link_slot() {
    local src="$1" dst="$2" mode="${3:-}"
    [ -f "$src" ] || return 0
    mkdir -p "$(dirname "$dst")"
    if [ -L "$dst" ]; then
        if [ "$(readlink "$dst")" = "$src" ]; then
            if [ -n "$mode" ]; then chmod "$mode" "$src" 2>/dev/null || true; fi
            return 0
        fi
        echo "private-links: $dst は別のリンク先を指しているためスキップ" >&2
        return 0
    fi
    if [ -e "$dst" ]; then
        echo "private-links: $dst が既に存在するためスキップ (退避してから chezmoi apply)" >&2
        return 0
    fi
    ln -s "$src" "$dst"
    if [ -n "$mode" ]; then chmod "$mode" "$src" 2>/dev/null || true; fi
}

# aws/config.work (仕事用) と aws/config (個人用) を 1 つの ~/.aws/config 実ファイル (600) にまとめる。
# - 先頭に置く aws/config.work の [default] を残し、aws/config 側の [default] は捨てる
# - それ以外のセクション名が両方にあればエラーにして何も書かない (AWS CLI は重複セクションで失敗する)
# - 生成物は通常のファイル。aws configure の書き込みは private 側には戻らない (docs/private-repo.md の AWS 節)
merge_aws_config() {
    local dst="$HOME/.aws/config" tmp src
    local -a srcs=()
    for src in "$AWS_WORK" "$AWS_PERSONAL"; do
        [ -f "$src" ] && srcs+=("$src")
    done
    mkdir -p "$(dirname "$dst")"
    tmp="$(mktemp "$HOME/.aws/.config.XXXXXX")"
    if ! {
        printf '%s\n' "# private-links が aws/config.work と aws/config から生成した実ファイル (machineProfile = work)" \
            "# ここを直接編集しても private 側には戻らない。元の定義を変えたら、このファイルを退避してから chezmoi apply する"
        for src in "${srcs[@]}"; do
            cat "$src"
            printf '\n'
        done
    } | awk '
        /^\[/ {
            name = $0
            sub(/[[:blank:]]+$/, "", name)
            skip = 0
            if (name in seen) {
                if (name != "[default]") {
                    print "private-links: セクション " name " が aws/config.work と aws/config の両方にある" > "/dev/stderr"
                    exit 1
                }
                skip = 1
            }
            seen[name] = 1
        }
        !skip
    ' > "$tmp"; then
        rm -f "$tmp"
        echo "private-links: 重複したセクションがあるため ~/.aws/config を生成しない" >&2
        return 0
    fi
    chmod 600 "$tmp"
    if [ -L "$dst" ]; then
        if [ "$(readlink "$dst")" = "$AWS_PERSONAL" ]; then
            # 以前の link_slot が張った個人用 aws/config へのリンクは、結合ファイルに置き換える
            rm -f "$dst"
        else
            echo "private-links: $dst は別のリンク先を指しているためスキップ" >&2
            rm -f "$tmp"
            return 0
        fi
    elif [ -e "$dst" ]; then
        # 生成結果と同じなら配置済み。違うときだけ警告する (上書きはしない)
        if ! cmp -s "$tmp" "$dst"; then
            echo "private-links: $dst が private 側の定義と異なるためスキップ (退避してから chezmoi apply)" >&2
        fi
        rm -f "$tmp"
        return 0
    fi
    mv "$tmp" "$dst"
}

AWS_PERSONAL="$PRIVATE_DIR/aws/config"
AWS_WORK="$PRIVATE_DIR/aws/config.work"

# --- スロット定義 ---
# 追加するときは link_slot <private 側> <HOME 側> [パーミッション] を 1 行足す。
# 例: link_slot "$PRIVATE_DIR/ssh/config" "$HOME/.ssh/config" 600

# machineProfile = work かつ aws/config.work があるマシンは結合して実ファイルを作る。
# それ以外 (個人用・profile 未設定・aws/config.work が無い) は従来どおり aws/config をシンボリックリンクする。
if [ "$MACHINE_PROFILE" = work ] && [ -f "$AWS_WORK" ]; then
    merge_aws_config
else
    link_slot "$AWS_PERSONAL" "$HOME/.aws/config" 600
fi

# ccgate (Claude Code の PermissionRequest hook) のグローバル設定。秘密情報ではないのでパーミッションは付けない
link_slot "$PRIVATE_DIR/claude/ccgate.jsonnet" "$HOME/.claude/ccgate.jsonnet"

# mise のツール定義。conf.d は後ろのファイル名ほど優先されるので、
# 公開 00-common.toml → private 10-private.toml → private 20-private-<profile>.toml の順で上書きできる。
# ~/.config/mise/config.toml (マシンローカル・管理外) は conf.d より優先される
MISE_CONF_D="$HOME/.config/mise/conf.d"
MISE_PRIVATE_DIR="$PRIVATE_DIR/mise"
MISE_LINK_COMMON="$MISE_CONF_D/10-private.toml"
MISE_LINK_PROFILE=""
link_slot "$MISE_PRIVATE_DIR/config.toml" "$MISE_LINK_COMMON"
if [ -n "$MACHINE_PROFILE" ]; then
    MISE_LINK_PROFILE="$MISE_CONF_D/20-private-$MACHINE_PROFILE.toml"
    link_slot "$MISE_PRIVATE_DIR/config.$MACHINE_PROFILE.toml" "$MISE_LINK_PROFILE"
fi

# 次のどちらかに当てはまる private 向けのリンクを消す (private を指すものだけ。実ファイルや他を指すリンクには触らない)
# - private 側のファイルを消した / profile を変えたため、配置対象ではなくなった
# - リンク先が無くなった (mise がリンク切れの設定を読んで警告を出すのを防ぐ)
for link in "$MISE_CONF_D"/*.toml; do
    [ -L "$link" ] || continue
    case "$(readlink "$link")" in
        "$MISE_PRIVATE_DIR"/*) ;;
        *) continue ;;
    esac
    if [ "$link" != "$MISE_LINK_COMMON" ] && [ "$link" != "$MISE_LINK_PROFILE" ]; then
        rm -f "$link"
    elif [ ! -e "$link" ]; then
        rm -f "$link"
    fi
done
