[core]
	editor = "nano"
	excludesfile = ~/.gitignore_global
[user]
	name = ryosan-470
	email = rskjtwp@gmail.com
	signingkey = 60C13C7737C6E4D0707828B19E53E96EAD309F72
[commit]
	gpgsign = true
[color]
	ui = auto
	status  = auto
	diff = auto
	branch = auto
	interactive = auto
	grep = auto
[push]
	default = simple
[alias]
	b = branch -a
	branches = branch -a # ブランチの一覧
	# ブランチ切り替え
	sw = !git switch `git branch | peco`
	c = commit
	stashes = stash list              # stash した一覧
	unstage = reset -q HEAD --
	discard = checkout --
	uncommit = reset --mixed HEAD~
	amend = commit --amend
	nevermind = !git reset --hard HEAD && git clean -d -f
	# リアルタイムのタイムラインを見ることができる
	precommit = diff --cached --diff-algorithm=minimal -w
	last = log -1 HEAD --format=format:"%Cred%H"
	untrack = rm -r --cached
	mergetrail = log --ancestry-path --merges
	l = log --graph --date=short --pretty=format:'%C(red reverse)%d%Creset%C(white reverse) %h% Creset %C(green reverse) %an %Creset %C(cyan)%ai%Creset%n%C(white bold)%w(80)%s%Creset%n%n%w(80,2,2)%b'
	hash = rev-parse HEAD
	p = !git push origin `git rev-parse --abbrev-ref HEAD`
	pf = !git push origin `git rev-parse --abbrev-ref HEAD` --force-with-lease
	delete-merged-branch = !git branch --merged | grep -v \\* | grep -v master | xargs -I % git branch -d %
	# blameしてそのコミットが含まれるPR番号を教えてくれます
	ag = "!git ls-files | xargs ag --pager=\"less -F -R\" --nogroup --color-match=0\\;31 --color-path=0\\;0 --no-numbers"
[commit]
	template = ~/.config/git/commit_template.txt
[grep]
	lineNumber = true
{{- /* diff-highlight は PATH にあればそれを、無ければ git 同梱の contrib を探す。見つからなければ設定しない */}}
{{- $dh := lookPath "diff-highlight" }}
{{- if not $dh }}
{{-   range list "/opt/homebrew/share/git-core/contrib/diff-highlight/diff-highlight" "/usr/local/share/git-core/contrib/diff-highlight/diff-highlight" "/usr/share/doc/git/contrib/diff-highlight/diff-highlight" "/usr/share/git-core/contrib/diff-highlight/diff-highlight" }}
{{-     if and (not $dh) (stat .) }}{{ $dh = . }}{{ end }}
{{-   end }}
{{- end }}
{{- if $dh }}
[pager]
	log = {{ $dh }} | less
	show = {{ $dh }} | less
	diff = {{ $dh }} | less
[interactive]
	diffFilter = {{ $dh }}
{{- end }}
[diff]
	compactionHeuristic = true
[ghq]
	root = ~/code/src
[pull]
	rebase = false
[fetch]
	prune = true
{{- /* Git Credential Manager が入っている環境だけ credential.helper を設定する */}}
{{- $gcm := lookPath "git-credential-manager" }}
{{- if not $gcm }}
{{-   range list "/usr/local/share/gcm-core/git-credential-manager" "/opt/homebrew/share/gcm-core/git-credential-manager" }}
{{-     if and (not $gcm) (stat .) }}{{ $gcm = . }}{{ end }}
{{-   end }}
{{- end }}
{{- if $gcm }}
[credential]
	helper = {{ $gcm }}
{{- end }}

# 仕事用レイヤー → マシン固有の設定の順に読み込む (後勝ち。ファイルが無ければ無視される)
# 仕事用 gitconfig 側で includeIf "gitdir:~/code/src/github.com/<社のorg>/" を使うと
# 社用 PC 上でも私用リポジトリは私用の email/署名のままにできる
[include]
	path = ~/.config/work/gitconfig
	path = ~/.gitconfig.local

