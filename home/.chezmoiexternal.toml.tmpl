[".tmux/plugins/tpm"]
    # サプライチェーン対策: ブランチ先頭ではなくタグ + checksum で固定する
    # 更新時は URL のタグを変え、checksum は chezmoi apply の SHA256 mismatch エラーに出る値へ書き換える
    type = "archive"
    url = "https://github.com/tmux-plugins/tpm/archive/refs/tags/v3.1.0.tar.gz"
    stripComponents = 1
    checksum.sha256 = "2411fc416c4475d297f61078d0a03afb3a1f5322fff26a13fdb4f20d7e975570"

[".zim/zimfw.zsh"]
    # zimfw 本体: releases/latest ではなくバージョン + checksum で固定する
    type = "file"
    url = "https://github.com/zimfw/zimfw/releases/download/v1.20.2/zimfw.zsh"
    checksum.sha256 = "918e8948d08346d5f1373ec628d858e4732fbbb9991b25c22d1a9b3443a2edc2"

{{ if index . "privateRepo" -}}
# private レイヤー: 個人用・仕事用の非公開設定 (シークレットはコミットしない)
# 公開リポジトリには URL を含めず、chezmoi init 時の入力値 (ローカルの chezmoi.toml) からのみ参照する
# index を使うのは、移行前の chezmoi.toml (workRepo のみ) でもテンプレートエラーにしないため
[".config/private"]
    type = "git-repo"
    url = {{ index . "privateRepo" | quote }}
    refreshPeriod = "24h"
{{- end }}
