{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_SIMPLE_SYSTEM_PROMPT": "1",
    "CLAUDE_CODE_DISABLE_FAST_MODE": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "includeGitInstructions": false,
  "$remove": {
    "permissions": {
      "allow": [
        "Bash(gh secret list)",
        "Bash(git push)"
      ],
      "deny": [
        "Bash(gh auth *)",
        "Bash(brew *)",
        "Bash(gh issue close *)",
        "Bash(gh pr close *)",
        "Bash(gh secret *)",
        "Bash(gh variable *)",
        "Bash(git checkout -- . *)",
        "Bash(git clean -fd *)",
        "Bash(wget *)"
      ],
      "ask": [
        "Bash(curl *)",
        "Bash(gh api *)",
        "Bash(gh api * -X*)",
        "Bash(gh api * --method*)",
        "Bash(gh api * -f*)",
        "Bash(gh api * -F*)",
        "Bash(gh api * --field*)",
        "Bash(gh api * --raw-field*)",
        "Bash(gh api * --input*)",
        "Bash(gh variable *)",
        "Bash(git push)",
        "Bash(git push *)",
        "Bash(git push --force)",
        "Bash(git push -f)",
        "Bash(git push origin --force *)",
        "Bash(git push origin -f *)",
        "Bash(git push --force-with-lease)",
        "Bash(git push --force-if-includes)",
        "Bash(git reset --hard)",
        "Bash(git restore)",
        "Bash(git checkout --)",
        "Bash(wget *)"
      ]
    }
  },
  "permissions": {
    "allow": [
      "Glob",
      "Grep",
      "Read",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:platform.claude.com)",
      "WebFetch(domain:json.schemastore.org)",
      "WebFetch(domain:developer.mozilla.org)",
      "WebFetch(domain:pkg.go.dev)",
      "Bash(mkdir *)",
      "Bash(ls *)",
      "Bash(gh api *)",
      "Bash(gh auth status *)",
      "Bash(gh issue list *)",
      "Bash(gh issue status *)",
      "Bash(gh issue view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr list *)",
      "Bash(gh pr status *)",
      "Bash(gh pr view *)",
      "Bash(gh release list *)",
      "Bash(gh release view *)",
      "Bash(gh repo list *)",
      "Bash(gh repo view *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh search *)",
      "Bash(gh secret list *)",
      "Bash(gh variable get *)",
      "Bash(gh variable list *)",
      "Bash(gh workflow list *)",
      "Bash(gh workflow view *)",
      "Bash(git branch *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git remote *)",
      "Bash(git show *)",
      "Bash(git stash list *)",
      "Bash(git status *)",
      "Bash(git tag *)",
      "Bash(git push *)"
    ],
    "deny": [
      "Read(**/.env*)",
      "Read(~/.aws/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.docker/config.json)",
      "Read(~/.git-credentials)",
      "Read(~/.gnupg/**)",
      "Read(~/.kube/config)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.ssh/**)",
      "Bash(gh auth login *)",
      "Bash(gh auth logout *)",
      "Bash(gh auth refresh *)",
      "Bash(gh auth setup-git *)",
      "Bash(gh auth status *--show-token*)",
      "Bash(gh auth switch *)",
      "Bash(gh auth token *)",
      "Bash(gh gpg-key *)",
      "Bash(gh issue delete *)",
      "Bash(gh pr delete *)",
      "Bash(gh release delete *)",
      "Bash(gh repo archive *)",
      "Bash(gh repo create *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo edit *)",
      "Bash(gh repo fork *)",
      "Bash(gh repo rename *)",
      "Bash(gh secret delete *)",
      "Bash(gh secret set *)",
      "Bash(gh ssh-key *)",
      "Bash(gh workflow disable *)",
      "Bash(gh workflow enable *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r -f *)",
      "Bash(rm -f -r *)",
      "Bash(rm -Rf *)",
      "Bash(rm -fR *)",
      "Bash(git rm -rf *)",
      "Bash(git rm -fr *)",
      "Bash(git rm -r -f *)",
      "Bash(shutdown *)",
      "Bash(sudo *)"
    ],
    "ask": [
      "Bash(brew *)",
      "Bash(gh api *-X*)",
      "Bash(gh api *--method*)",
      "Bash(gh api *-f *)",
      "Bash(gh api *-F *)",
      "Bash(gh api *--field*)",
      "Bash(gh api *--raw-field*)",
      "Bash(gh api *--input*)",
      "Bash(gh issue comment *)",
      "Bash(gh issue close *)",
      "Bash(gh issue edit *)",
      "Bash(gh pr create *)",
      "Bash(gh pr close *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr review *)",
      "Bash(gh variable delete *)",
      "Bash(gh variable set *)",
      "Bash(git branch -D *)",
      "Bash(git branch -d *)",
      "Bash(git branch -f *)",
      "Bash(git branch -m *)",
      "Bash(git commit *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push --force-if-includes *)",
      "Bash(git push --delete *)",
      "Bash(git push -d *)",
      "Bash(git push --mirror *)",
      "Bash(git push --prune *)",
      "Bash(git reset --hard *)",
      "Bash(git restore *)",
      "Bash(git clean *)",
      "Bash(git checkout -- *)",
      "Bash(git checkout .)",
      "Bash(git checkout -f *)",
      "Bash(git rm *)",
      "Bash(git tag -d *)",
      "Bash(git tag -f *)",
      "Bash(git remote remove *)",
      "Bash(git remote set-url *)",
      "Bash(git stash drop *)",
      "Bash(git stash clear *)",
      "Bash(rm *)",
      "Bash(mv *)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "if command -v ccgate >/dev/null 2>&1; then ccgate claude; fi",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if command -v rtk >/dev/null 2>&1; then rtk hook claude; fi",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/find-guard.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/dangerous-command-guard.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "commit-commands@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "yomiyasu@yomiyasu": true
  },
  "extraKnownMarketplaces": {
    "yomiyasu": {
      "source": {
        "source": "github",
        "repo": "nanaism/yomiyasu",
        "ref": "v3.1.0"
      },
      "autoUpdate": false
    }
  },
  "language": "japanese",
  "modelSettings": {
    "claude-sonnet-5-5": {
      "effortLevel": "xhigh",
      "autoCompactWindow": 300000
    },
    "claude-opus-5-5": {
      "effortLevel": "high",
      "autoCompactWindow": 400000
    },
    "claude-haiku-5-5": {
      "effortLevel": "high",
      "autoCompactWindow": 300000
    }
  },
  "theme": "dark-ansi",
  "teammateMode": "tmux",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
