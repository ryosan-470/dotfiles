{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_SIMPLE_SYSTEM_PROMPT": "1",
    "CLAUDE_CODE_DISABLE_FAST_MODE": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1"
  },
  "includeCoAuthoredBy": false,
  "includeGitInstructions": false,
  "permissions": {
    "allow": [
      "Glob",
      "Grep",
      "Read",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:developer.mozilla.org)",
      "WebFetch(domain:pkg.go.dev)",
      "Bash(mkdir *)",
      "Bash(ls *)",
      "Bash(gh issue list *)",
      "Bash(gh issue status *)",
      "Bash(gh issue view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr list *)",
      "Bash(gh pr status *)",
      "Bash(gh pr view *)",
      "Bash(gh release list *)",
      "Bash(gh release view *)",
      "Bash(gh repo list *)",
      "Bash(gh repo view *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh search *)",
      "Bash(gh workflow list *)",
      "Bash(gh workflow view *)",
      "Bash(git branch *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git remote *)",
      "Bash(git show *)",
      "Bash(git stash list *)",
      "Bash(git status *)",
      "Bash(git tag *)",
      "Bash(git push)",
      "Bash(git push *)"
    ],
    "deny": [
      "Read(**/.env*)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.docker/config.json)",
      "Read(~/.gnupg/**)",
      "Read(~/.kube/config)",
      "Read(~/.netrc)",
      "Read(~/.ssh/**)",
      "Bash(gh auth *)",
      "Bash(gh gpg-key *)",
      "Bash(gh issue delete *)",
      "Bash(gh pr delete *)",
      "Bash(gh release delete *)",
      "Bash(gh repo archive *)",
      "Bash(gh repo create *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo edit *)",
      "Bash(gh repo fork *)",
      "Bash(gh repo rename *)",
      "Bash(gh secret *)",
      "Bash(gh ssh-key *)",
      "Bash(gh workflow disable *)",
      "Bash(gh workflow enable *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r -f *)",
      "Bash(rm -f -r *)",
      "Bash(rm -Rf *)",
      "Bash(rm -fR *)",
      "Bash(git rm -rf *)",
      "Bash(git rm -fr *)",
      "Bash(git rm -r -f *)",
      "Bash(shutdown *)",
      "Bash(sudo *)"
    ],
    "ask": [
      "Bash(brew *)",
      "Bash(gh api *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue close *)",
      "Bash(gh issue edit *)",
      "Bash(gh pr create *)",
      "Bash(gh pr close *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr review *)",
      "Bash(gh variable *)",
      "Bash(git commit *)",
      "Bash(git push --force)",
      "Bash(git push --force *)",
      "Bash(git push -f)",
      "Bash(git push -f *)",
      "Bash(git push origin --force *)",
      "Bash(git push origin -f *)",
      "Bash(git push --force-with-lease)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push --force-if-includes)",
      "Bash(git push --force-if-includes *)",
      "Bash(git reset --hard)",
      "Bash(git reset --hard *)",
      "Bash(git restore)",
      "Bash(git restore *)",
      "Bash(git clean *)",
      "Bash(git checkout --)",
      "Bash(git checkout -- *)",
      "Bash(git checkout .)",
      "Bash(git checkout -f *)",
      "Bash(git rm *)",
      "Bash(rm *)",
      "Bash(mv *)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "if command -v ccgate >/dev/null 2>&1; then ccgate claude; fi"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if command -v rtk >/dev/null 2>&1; then rtk hook claude; fi"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/find-guard.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/dangerous-command-guard.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "code-review@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "cclens@cclens": true,
    "yomiyasu@yomiyasu": true
  },
  "extraKnownMarketplaces": {
    "cclens": {
      "source": {
        "source": "github",
        "repo": "lambdalisue/cclens",
        "ref": "v0.1.1"
      },
      "autoUpdate": false
    },
    "yomiyasu": {
      "source": {
        "source": "github",
        "repo": "nanaism/yomiyasu",
        "ref": "v2.5.0"
      },
      "autoUpdate": false
    }
  },
  "language": "日本語",
  "modelSettings": {
    "claude-sonnet-5-5": {
      "effortLevel": "xhigh",
      "autoCompactWindow": 300000
    },
    "claude-opus-5-5": {
      "effortLevel": "high",
      "autoCompactWindow": 400000
    },
    "claude-haiku-5-5": {
      "effortLevel": "high",
      "autoCompactWindow": 300000
    }
  },
  "theme": "dark-ansi",
  "teammateMode": "tmux",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
