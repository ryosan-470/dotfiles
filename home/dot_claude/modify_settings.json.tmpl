#!/bin/bash
# ~/.claude/settings.json を生成する chezmoi modify スクリプト
#
# Claude Code や他のアプリ (Orca など) は settings.json を自分で書き換える
# (「常に許可」の追加や hooks の注入。シンボリックリンクも実ファイルに置き換わる)。
# そのため単純なコピー/リンクではなく、以下の 3 層をマージして出力する:
#   1. 現在のファイル (stdin)          ... ローカルで追加された設定
#   2. settings.base.json (リポジトリ) ... 共通設定。同じキーは 1 を上書きする
#   3. ~/.config/work/claude/settings.json (あれば) ... 仕事用設定。同じキーは 2 を上書きする
# permissions の allow/ask/deny/additionalDirectories は 3 層の和集合。
# hooks はイベントごとに 3 層を合わせる。ただしリポジトリ側 (2, 3) と同じ command を含む
# ローカルのエントリはリポジトリ側で置き換える (timeout 等の変更が重複しないように)。
# 既存の設定は消さない方針なので、リポジトリから削除した権限/hook は既存マシンには残る。
set -euo pipefail

base={{ joinPath .chezmoi.sourceDir "dot_claude" "settings.base.json" | quote }}
work="$HOME/.config/work/claude/settings.json"

current=$(cat)
[ -f "$work" ] || work=/dev/null

if ! command -v jq >/dev/null 2>&1; then
    # マージできないときは既存のファイルを壊さない
    if [ -n "$current" ]; then
        printf '%s\n' "$current"
    else
        cat "$base"
    fi
    exit 0
fi

[ -n "$current" ] || current='{}'

jq -n \
    --argjson cur "$current" \
    --slurpfile base "$base" \
    --slurpfile work "$work" '
def dedupe: reduce .[] as $x ([]; if any(.[]; . == $x) then . else . + [$x] end);
def cmds: [.hooks[]?.command];

$base[0] as $b
| ($work[0] // {}) as $w
| ($cur * $b * $w)
| reduce ("allow", "ask", "deny", "additionalDirectories") as $k (.;
    ([$cur, $b, $w] | map(.permissions[$k] // []) | add | dedupe) as $v
    | if ($v | length) > 0 then .permissions[$k] = $v else . end)
| ([$cur, $b, $w] | map(.hooks // {} | keys) | add | unique) as $events
| if ($events | length) > 0 then
    .hooks = reduce $events[] as $e ({};
      (($b.hooks[$e] // []) + ($w.hooks[$e] // [])) as $managed
      | [$managed[] | cmds[]] as $mc
      | [($cur.hooks[$e] // [])[] | select((cmds - $mc) == cmds)] as $local
      | .[$e] = ($local + $managed | dedupe))
  else . end
'
