#!/bin/bash
# ~/.claude/settings.json を生成する chezmoi modify スクリプト
#
# Claude Code や他のアプリ (Orca など) は settings.json を自分で書き換える
# (「常に許可」の追加や hooks の注入。シンボリックリンクも実ファイルに置き換わる)。
# そのため単純なコピー/リンクではなく、以下の 4 層をマージして出力する:
#   1. 現在のファイル (stdin)          ... ローカルで追加された設定
#   2. settings.base.json (リポジトリ) ... 共通設定。同じキーは 1 を上書きする
#   3. ~/.config/private/claude/settings.json (あれば) ... private 共通設定。同じキーは 2 を上書きする
#   4. ~/.config/private/claude/settings.<machineProfile>.json (あれば) ... マシンのプロファイル別設定。同じキーは 3 を上書きする
# permissions の allow/ask/deny/additionalDirectories は 4 層の和集合。
# hooks はイベントごとに 4 層を合わせる。ただしリポジトリ側 (2, 3, 4) と同じ command を含む
# ローカルのエントリはリポジトリ側で置き換える (timeout 等の変更が重複しないように)。
# 既存の設定は消さない方針なので、リポジトリから削除した権限/hook は既存マシンには残る。
# 例外として、各層のトップレベルに "$replace": ["env", ...] を書くと、列挙したキーは
# それより前の層 (ローカルを含む) と深いマージをせず、その層の値で丸ごと置き換える
# (その層に値が無ければキーごと削除)。"$replace" 自体は出力しない。
# permissions / hooks は上記の和集合ルールが優先されるため "$replace" の対象外。
#
# permissions から古いエントリを消したい場合は、任意の層に
#   "$remove": {"permissions": {"deny": [...], "ask": [...], "allow": [...]}}
# を書くと、4 層の和集合から完全一致するエントリを削除する (追加より削除が優先)。
# "$remove" 自体は出力しない。hooks の削除には対応しない。
set -euo pipefail

base={{ joinPath .chezmoi.sourceDir "dot_claude" "settings.base.json" | quote }}
private_settings="$HOME/.config/private/claude/settings.json"
private_profile={{ index . "machineProfile" | default "" | quote }}
private_profile_settings="$HOME/.config/private/claude/settings.$private_profile.json"

current=$(cat)
[ -f "$private_settings" ] || private_settings=/dev/null
if [ -z "$private_profile" ] || [ ! -f "$private_profile_settings" ]; then
    private_profile_settings=/dev/null
fi

if ! command -v jq >/dev/null 2>&1; then
    # マージできないときは既存のファイルを壊さない
    if [ -n "$current" ]; then
        printf '%s\n' "$current"
    else
        cat "$base"
    fi
    exit 0
fi

[ -n "$current" ] || current='{}'

jq -n \
    --argjson cur "$current" \
    --slurpfile base "$base" \
    --slurpfile private "$private_settings" \
    --slurpfile profile "$private_profile_settings" '
def dedupe: reduce .[] as $x ([]; if any(.[]; . == $x) then . else . + [$x] end);
def cmds: [.hooks[]?.command];
# 層 $l を重ねる。$l の "$replace" に列挙したキーは深いマージせずに置き換える
def overlay($l):
  (($l["$replace"] // []) - ["permissions", "hooks"]) as $r
  | delpaths([$r[] | [.]]) * ($l | del(.["$replace"], .["$remove"]));

$base[0] as $b
| ($private[0] // {}) as $p
| ($profile[0] // {}) as $pp
| reduce ($b, $p, $pp) as $l ($cur | del(.["$replace"], .["$remove"]); overlay($l))
| reduce ("allow", "ask", "deny", "additionalDirectories") as $k (.;
    ([$cur, $b, $p, $pp] | map(.permissions[$k] // []) | add // [] | dedupe) as $v
    | ([$cur, $b, $p, $pp] | map(."$remove".permissions[$k] // []) | add // [] | unique) as $rm
    | ($v - $rm) as $keep
    | if ($keep | length) > 0 then .permissions[$k] = $keep else del(.permissions[$k]) end)
| ([$cur, $b, $p, $pp] | map(.hooks // {} | keys) | add | unique) as $events
| if ($events | length) > 0 then
    .hooks = reduce $events[] as $e ({};
      (($b.hooks[$e] // []) + ($p.hooks[$e] // []) + ($pp.hooks[$e] // [])) as $managed
      | [$managed[] | cmds[]] as $mc
      | [($cur.hooks[$e] // [])[] | select((cmds - $mc) == cmds)] as $local
      | .[$e] = ($local + $managed | dedupe))
  else . end
'
